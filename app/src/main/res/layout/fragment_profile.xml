<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface"
    android:gravity="center_horizontal">

    <!-- أيقونة البروفايل -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="?attr/colorPrimary"/>

    <!-- إيميل المستخدم -->
    <TextView
        android:id="@+id/tvProfileEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:text="Loading..." />

    <!-- مسافة فارغة -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <!-- زرار المفضلة -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoToFavorites"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="My Favorites"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/btn_star" />

    <!-- زرار خطة الوجبات -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoToPlan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="My Meal Plan"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_today" />

    <!-- مسافة لدفع زرار الخروج لأسفل الشاشة -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- زرار تسجيل الخروج -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Logout"
        android:textColor="@color/bg_white"
        app:cornerRadius="12dp"
        app:backgroundTint="#D32F2F"
        app:iconTint="@color/bg_white" />

</LinearLayout>